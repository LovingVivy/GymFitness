APP_NAME=GymFitness API
APP_ENV=development
DOCS_ENABLED=true
FRONTEND_ORIGINS=["http://localhost:5173"]

# Bắt buộc >= 32 ký tự ngẫu nhiên khi APP_ENV khác development. Sinh bằng:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=gymfitness_app
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=gymfitness

REDIS_URL=redis://127.0.0.1:6379/0

# Thanh toán chuyển khoản QR (VietQR + webhook SePay)
# PAYMENT_BANK_CODE: mã ngân hàng theo VietQR, ví dụ MB, VCB, TCB hoặc BIN 970422
PAYMENT_BANK_CODE=
PAYMENT_ACCOUNT_NO=
PAYMENT_ACCOUNT_NAME=
PAYMENT_CODE_PREFIX=IRX
# Trùng với API key khai báo ở SePay → Webhooks → Chứng thực "API Key"
SEPAY_WEBHOOK_API_KEY=
# Bỏ trống = tự bật nút "giả lập đã nhận tiền" ở dev, tắt ở production
PAYMENT_SIMULATION_ENABLED=

# Tài khoản quản trị mặc định: tạo khi backend khởi động nếu chưa tồn tại.
# Không bao giờ ghi đè mật khẩu của tài khoản đã có. Để trống mật khẩu = bỏ qua.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@gmail.com
ADMIN_DEFAULT_PASSWORD=

# --- Vận hành --------------------------------------------------------------
# LOG_FORMAT: json | text | auto (text khi dev, json khi production)
LOG_LEVEL=INFO
LOG_FORMAT=auto
# Redis dùng cho cache, rate limit và hàng đợi tác vụ. Không có Redis: API vẫn chạy
# (cache/rate limit trong bộ nhớ, tác vụ chạy luồng nền). REDIS_ENABLED=false để tắt hẳn.
REDIS_ENABLED=true
CACHE_ENABLED=true
CACHE_CATALOG_TTL_SECONDS=300
CACHE_REPORT_TTL_SECONDS=120
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=300
# auto | redis (cần chạy: python -m app.tasks.worker) | thread | inline
JOB_QUEUE_MODE=auto

# --- Email -----------------------------------------------------------------
# SMTP_HOST trống = không gửi thật, email được ghi ra storage/outbox/*.eml
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=IRONIX Fitness <no-reply@ironix.vn>
FRONTEND_BASE_URL=http://localhost:5173
PASSWORD_RESET_TTL_MINUTES=30

# --- Xác thực 2 bước và PDF --------------------------------------------------
TWO_FACTOR_ISSUER=IRONIX Fitness
# Font TTF có dấu tiếng Việt; trống = tự tìm DejaVuSans (Linux/Docker) hoặc Arial (Windows/macOS)
PDF_FONT_PATH=

# --- Bảo trì định kỳ (hết hạn gói, nhắc gia hạn, tự đóng buổi PT quá hạn) ---
# Chạy trong API khi không có worker; docker compose đặt false vì worker đảm nhận.
MAINTENANCE_IN_API=true
MAINTENANCE_INTERVAL_SECONDS=300
PT_AUTOCLOSE_HOURS=24
