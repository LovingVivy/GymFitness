MYSQL_DATABASE=gymfitness
MYSQL_USER=gymfitness_app
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_root_me
MYSQL_HOST_PORT=3307
BACKEND_PORT=8000
FRONTEND_ORIGINS=["http://localhost:5173"]

# Sinh bằng: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# Tài khoản nhận tiền hiển thị trên VietQR và API key webhook SePay
PAYMENT_BANK_CODE=
PAYMENT_ACCOUNT_NO=
PAYMENT_ACCOUNT_NAME=
PAYMENT_CODE_PREFIX=IRX
SEPAY_WEBHOOK_API_KEY=

# Tài khoản quản trị mặc định: tạo khi backend khởi động nếu chưa tồn tại.
# Không bao giờ ghi đè mật khẩu của tài khoản đã có. Để trống mật khẩu = bỏ qua.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@gmail.com
ADMIN_DEFAULT_PASSWORD=

# Cổng giao diện (nginx) khi chạy docker compose
FRONTEND_PORT=8080
# Địa chỉ giao diện, dùng để dựng liên kết trong email (đặt lại mật khẩu)
FRONTEND_BASE_URL=http://localhost:8080

# Email: để trống = dùng Mailpit trong docker compose (xem thư tại http://localhost:8025)
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=
MAIL_FROM=IRONIX Fitness <no-reply@ironix.vn>

# json (một dòng JSON mỗi log) hoặc text
LOG_FORMAT=json
